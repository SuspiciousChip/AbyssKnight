[node name="Panel" type="PanelContainer" parent="Center"]
custom_minimum_size = Vector2(720, 300)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="Center/Panel"]
layout_mode = 2
theme_override_constants/separation = 15

[node name="Header" type="HBoxContainer" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="RuneIcon" type="TextureRect" parent="Center/Panel/VBox/Header"]
custom_minimum_size = Vector2(32, 32)
layout_mode = 2
expand_mode = 1
stretch_mode = 5
texture_filter = 1

[node name="Heading" type="Label" parent="Center/Panel/VBox/Header"]
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.59, 1, 1)
theme_override_fonts/font = SubResource("SystemFont_math")
theme_override_font_sizes/font_size = 25
text = "∑  ABYSS EQUATION"

[node name="Divider" type="HSeparator" parent="Center/Panel/VBox"]
layout_mode = 2

[node name="Question" type="Label" parent="Center/Panel/VBox"]
custom_minimum_size = Vector2(0, 62)
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.96, 0.79, 1)
theme_override_fonts/font = SubResource("SystemFont_math")
theme_override_font_sizes/font_size = 43
text = "2x + 3 = 5"
horizontal_alignment = 1
vertical_alignment = 1

[node name="Prompt" type="Label" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.74, 0.72, 0.82, 1)
theme_override_font_sizes/font_size = 18
text = "Find x. Your answer becomes the number of hits."
