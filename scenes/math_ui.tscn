[gd_scene format=3]

[ext_resource type="Script" path="res://scenes/math_ui.gd" id="1_script"]

[sub_resource type="SystemFont" id="SystemFont_math"]
font_names = PackedStringArray("Menlo", "DejaVu Sans Mono", "Monospace")

[node name="MathUI" type="CanvasLayer"]
layer = 10
script = ExtResource("1_script")

[node name="Dim" type="ColorRect" parent="."]
