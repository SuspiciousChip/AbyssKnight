[node name="InputRow" type="HBoxContainer" parent="Center/Panel/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="XLabel" type="Label" parent="Center/Panel/VBox/InputRow"]
layout_mode = 2
